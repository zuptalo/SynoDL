# synodl configuration — every setting is an environment variable.
# Copy to server/.env for local overrides (`make start` sources it).

# dev | production. Dev defaults SYNO_URL to the local mock DSM.
#ENV=dev

# HTTP listen port.
#PORT=8080

# Base URL of the NAS's DSM. REQUIRED in production.
#   make start uses the in-repo mock: http://localhost:8091
#SYNO_URL=https://nas.local:5001

# Accept a self-signed NAS certificate (outbound connection only).
# Deliberate opt-in; leave off unless you know you need it.
#SYNO_TLS_INSECURE=false

# Browser origins allowed via CORS (dev only; production is same-origin).
#ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Serve the built PWA from this directory (production single-container mode).
#STATIC_DIR=/app/web

# Dev only: reverse-proxy non-API requests to a running Vite dev server.
#DEV_PROXY=http://localhost:5173

# Upload cap for .torrent files, in MiB.
#MAX_TORRENT_MB=16

# Per-IP rate limit for login attempts, per minute.
#LOGIN_PER_MINUTE=10
