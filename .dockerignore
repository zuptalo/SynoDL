# Keep the build context small and never bake local/runtime state into an image.

# VCS + editor noise
.git
.gitignore
.gitattributes
.DS_Store
.vscode
.idea

# Dependencies + build outputs (all rebuilt inside the image)
node_modules
dist
dist-ssr
dev-dist

# Go build artifacts and local secrets (MUST NOT enter an image)
server/tmp
server/synodl
server/synomock
server/.env
**/*.local
.env
.env.*

# Test + tooling artifacts
test-results
playwright-report
playwright/.cache
coverage
.tmp

# Local agent/editor state and CI definitions (not needed to build the image)
.claude
.github
README.md
